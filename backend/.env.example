# Copy this file to ".env" in the backend/ folder and fill in your key.
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
#
# This is used automatically by every endpoint (chat, upload, streaming) if
# no api_key is passed explicitly from the frontend's Settings page.
GEMINI_API_KEY=your_key_here

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed Vercel URL here in production.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
